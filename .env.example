# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Upstream portal (required) ---
PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
PORTAL_USERNAME=operator@urja.local
PORTAL_PASSWORD=replace-me

# --- Service ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console          # 'console' locally, 'json' in production

# --- Snapshot / freshness ---
SNAPSHOT_TTL_SECONDS=300
SNAPSHOT_REFRESH_ON_START=true
CONSUMPTION_CACHE_TTL_SECONDS=120

# --- Upstream client tuning ---
PORTAL_MAX_RETRIES=3
PORTAL_MAX_CONCURRENCY=6
SESSION_REFRESH_MARGIN_SECONDS=120

# --- HTTP client tuning (all optional; defaults shown) ---
PORTAL_CONNECT_TIMEOUT=5.0
PORTAL_READ_TIMEOUT=20.0
PORTAL_MAX_CONNECTIONS=10
PORTAL_BACKOFF_BASE=0.25
PORTAL_BACKOFF_MAX=4.0
CONSUMPTION_CACHE_MAX_ENTRIES=256

# --- API surface (all optional; defaults shown) ---
API_PREFIX=/api/v1
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=200

# Comma-separated allowlist. Empty (default) disables CORS entirely.
# Never use "*" - this service has no authentication of its own.
CORS_ALLOW_ORIGINS=

# --- Service identity (rarely changed) ---
APP_NAME=Flock Energy - Urja Meter Ops API
APP_VERSION=1.0.0
