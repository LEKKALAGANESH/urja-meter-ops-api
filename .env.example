# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Upstream portal (required) ---
PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
PORTAL_USERNAME=operator@urja.local
PORTAL_PASSWORD=replace-me

# --- Service ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console          # 'console' locally, 'json' in production

# --- Snapshot / freshness ---
SNAPSHOT_TTL_SECONDS=300
SNAPSHOT_REFRESH_ON_START=true
CONSUMPTION_CACHE_TTL_SECONDS=120

# --- Upstream client tuning ---
PORTAL_MAX_RETRIES=3
PORTAL_MAX_CONCURRENCY=6
SESSION_REFRESH_MARGIN_SECONDS=120
